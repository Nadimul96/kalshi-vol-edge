# Copy to .env (git-ignored). Every variable is optional.
# The dashboard, backtest, report and `kve reconcile --dry-run` need no key at all.

# ── Kalshi key: account view (read-only) and `kve order` ───────────────────────
# Keys are per exchange. Kalshi's demo exchange is free paper trading; create an account
# there and generate an API key. The private key is downloaded once as a PEM file.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
# demo | prod. Used for account reads. `kve order` always uses demo unless --live is passed.
KALSHI_ENVIRONMENT=demo

# ── Market data (public, no key) ───────────────────────────────────────────────
# KALSHI_MARKET_DATA_URL=https://api.elections.kalshi.com/trade-api/v2
# KALSHI_SERIES=KXBTC15M
# COINBASE_BASE_URL=https://api.exchange.coinbase.com

# ── Order guard rails for `kve order` ──────────────────────────────────────────
# KVE_MAX_POSITION_CONTRACTS=10
# KVE_MAX_ORDER_USD=10

# ── Local state ────────────────────────────────────────────────────────────────
# KVE_DB_PATH=data/kve.sqlite3
# KVE_FIXTURES_DIR=data/sample
